{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["packages/**/*.ts", "plugins/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}

